APP_NAME="Spring Security App"

# Config del Redis Cache
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Config de la DB
JDBC_DRIVER=org.postgresql.Driver
JDBC_HOST=postgres
JDBC_PORT=5432
JDBC_DATABASE=securitydatabase
JDBC_SCHEMA=public
JDBC_USERNAME=postgres
JDBC_PASSWORD=admin

# Config de Metabase
METABASE_DB_NAME=metabase_internal
METABASE_DB_USER=postgres
METABASE_DB_PWD=admin

# Config de JWT
JWT_SECRET=my-secret-key
JWT_EXPIRATION_MINUTES=15